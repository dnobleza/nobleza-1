PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://app:app@127.0.0.1:54320/codehaus_new_project
TEST_DATABASE_URL=postgres://app:app@127.0.0.1:54320/codehaus_test
# Secret that signs login tokens. Replace with a long random value in your own .env. Never commit the real one.
JWT_SECRET=replace-me-with-a-long-random-string
# How long a login token stays valid (default 1h).
JWT_EXPIRES_IN=1h
# Frontend addresses allowed to call the API, comma-separated. Required in production.
CORS_ORIGIN=http://localhost:5173
